<?xml version="1.0" encoding="utf-8"?>
<!-- El código de emparejamiento no se copia a la nube ni a otro celular. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
