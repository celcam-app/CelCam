<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <app.celcam.AspectTextureView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Durante la transmisión -->
    <LinearLayout
        android:id="@+id/live_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/status_text"
            style="@style/CelCam.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/problem_text"
            style="@style/CelCam.Chip.Problem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/zoom_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/zoom_label"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/zoom_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="horizontal"
            android:padding="6dp">

            <Button
                android:id="@+id/switch_button"
                style="@style/CelCam.Tool"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_switch"
                android:text="@string/cambiar_camara" />

            <Button
                android:id="@+id/torch_button"
                style="@style/CelCam.Tool"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_torch"
                android:text="@string/linterna" />

            <Button
                android:id="@+id/dim_button"
                style="@style/CelCam.Tool"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_dim"
                android:text="@string/oscurecer" />

            <Button
                android:id="@+id/stop_button"
                style="@style/CelCam.Tool"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_stop"
                android:text="@string/detener" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sin transmisión -->
    <LinearLayout
        android:id="@+id/idle_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo"
        android:fitsSystemWindows="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_videocam" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/texto"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/idle_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:text="@string/ayuda_primera_vez"
            android:textColor="@color/texto_suave"
            android:textSize="16sp" />

        <Button
            android:id="@+id/connect_button"
            style="@style/CelCam.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/scan_button"
            style="@style/CelCam.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/escanear" />
    </LinearLayout>

    <!-- Pantalla negra para gastar menos batería; un toque la saca -->
    <FrameLayout
        android:id="@+id/dim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/oscuro_ayuda"
            android:textColor="#55FFFFFF"
            android:textSize="14sp" />
    </FrameLayout>
</FrameLayout>
