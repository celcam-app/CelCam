<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CelCam" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <item name="colorPrimary">@color/acento</item>
        <item name="colorAccent">@color/acento</item>
    </style>

    <style name="CelCam.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CelCam.Chip.Problem">
        <item name="android:textColor">@color/aviso</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="CelCam.Tool" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/herramienta_texto</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/herramienta_texto</item>
        <item name="android:paddingHorizontal">2dp</item>
        <item name="android:minHeight">64dp</item>
    </style>

    <style name="CelCam.Primary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@color/acento_texto</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="CelCam.Secondary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_secondary</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
    </style>
</resources>
